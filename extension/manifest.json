{
  "manifest_version": 3,
  "name": "Said.md",
  "version": "0.1.7",
  "description": "Turn YouTube captions into Markdown, preview them, and download.",
  "action": {
    "default_title": "Said.md"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "tabs", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtu.be/*",
    "https://i.ytimg.com/*",
    "https://i9.ytimg.com/*",
    "https://img.youtube.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "http://localhost:3002/*",
    "http://127.0.0.1:3002/*",
    "https://*.vercel.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' blob: data: https://i.ytimg.com https://i9.ytimg.com https://img.youtube.com;"
  }
}
